# =====================================================
# Variables del frontend (seguras para Netlify / publicas)
# Consiguelas en: Supabase Dashboard → Settings → API
# =====================================================
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# =====================================================
# Variables SOLO para el script de importacion (nunca en el navegador)
# Copia este archivo a .env y llenalas. El archivo .env NO se sube a git.
# =====================================================
# Supabase Dashboard → Settings → API → service_role (clave secreta)
SUPABASE_SERVICE_ROLE_KEY=
# https://spoonacular.com/food-api → Dashboard → API Key
SPOONACULAR_API_KEY=

# Opcional: control de lotes del importador (default 0 y 20)
OFFSET=0
NUMERO=20